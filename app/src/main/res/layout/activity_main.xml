<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F5F7FB">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:gravity="center_horizontal" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="48dp" android:text="M30 VPN" android:textColor="#15213A"
            android:textSize="34sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:text="اتصال امن و سریع" android:textColor="#667085" android:textSize="16sp"/>
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="42dp" android:gravity="center" android:text="قطع است"
            android:textColor="#667085" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/config_info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="18dp" android:gravity="center" android:text="No configuration imported"
            android:textColor="#15213A" android:textSize="15sp"/>
        <Button android:id="@+id/import_config" android:layout_width="match_parent" android:layout_height="58dp"
            android:layout_marginTop="18dp" android:text="IMPORT CONFIG (.conf)" android:textSize="16sp"/>
        <Button android:id="@+id/import_clipboard" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:text="وارد کردن از کلیپ‌بورد"/>
        <TextView android:id="@+id/dns_info" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="26dp" android:gravity="center" android:text="DNS: 1.1.1.1, 8.8.8.8"
            android:textColor="#15213A" android:textSize="15sp"/>
        <Button android:id="@+id/change_dns" android:layout_width="match_parent" android:layout_height="54dp"
            android:layout_marginTop="10dp" android:text="تغییر DNS"/>
        <Button android:id="@+id/connect" android:layout_width="match_parent" android:layout_height="64dp"
            android:layout_marginTop="28dp" android:text="اتصال" android:textSize="18sp"/>
    </LinearLayout>
</ScrollView>